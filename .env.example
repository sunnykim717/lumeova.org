# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings → API page. .env.local is git-ignored — never commit it.

# Public — safe to expose to the browser (also set these as build-time env
# vars in Cloudflare Pages/Workers).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — spam protection for public forms.
# Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only. The admin back office authorizes through Postgres RLS using
# the signed-in admin's session (anon key above). The ONLY code that uses
# this key is the scheduled news sync (src/lib/sync/newsSheet.ts, called from
# src/app/api/cron/sync-news/route.ts), approved in
# docs/superpowers/specs/2026-10-21-admin-automation-and-site-content-design.md
# §8.13. Server environment variable only, never prefixed NEXT_PUBLIC_,
# never committed.
# SUPABASE_SERVICE_ROLE_KEY=

# News sheet sync (design §6.1). The CSV URL is read only from here; users
# can never supply one. CRON_SECRET must match the GitHub Actions secret of
# the same name. Generate a long random value (for example: openssl rand -hex 32).
# NEWS_SHEET_CSV_URL=
# CRON_SECRET=
