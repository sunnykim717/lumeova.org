# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings → API page. .env.local is git-ignored — never commit it.

# Public — safe to expose to the browser (also set these as build-time env
# vars in Cloudflare Pages/Workers).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NOT required for the app to run today — the admin back
# office authorizes entirely through Postgres RLS (see
# supabase/migrations/0001_init.sql), using the signed-in admin's own
# session via the anon key above. Only set this if a future feature
# genuinely needs to bypass RLS (see src/lib/supabase/admin.ts for why that
# should be rare). If you do set it: server environment variable only,
# never prefixed NEXT_PUBLIC_, never committed.
# SUPABASE_SERVICE_ROLE_KEY=
